PORT=8787
DB_PATH=./data/porkin.db
PROVIDER=openai
MODEL=gpt-5.1
PROVIDER_API_KEY=sk-...
# Gates /v1/admin/* (issuing license keys). Min 24 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_KEY=
MAX_UPLOAD_MB=15
RATE_LIMIT_PER_MIN=20
# Monthly spend cap (USD of provider cost) given to NEW users. Existing users keep
# the limit on their row — change theirs with PATCH /v1/admin/users/:id.
DEFAULT_MONTHLY_LIMIT_USD=1.00
# Optional: override MODEL's price (USD per 1M tokens) without a code change.
# Defaults live in src/pricing.ts.
# PRICE_INPUT_PER_MTOK=1.25
# PRICE_CACHED_INPUT_PER_MTOK=0.125
# PRICE_OUTPUT_PER_MTOK=10.0
